# Skopíruj na .env a doplň vlastné hodnoty. Súbor .env sa nikdy necommituje.
# Všetky premenné sú voliteľné – bez nich aplikácia beží v lokálnom režime.

# --- Supabase (uložisko trás mimo prehliadača) ---------------
# Project Settings → API
VITE_SUPABASE_URL=https://tvoj-projekt.supabase.co
VITE_SUPABASE_ANON_KEY=tvoj-anon-public-key

# --- OpenRouteService (počítanie trás) -----------------------
# Registrácia zdarma: https://openrouteservice.org/dev/#/signup
# Bez kľúča sa zobrazí priama čiara a vzdušná vzdialenosť.
VITE_ORS_API_KEY=
